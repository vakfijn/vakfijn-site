      "source": "/vastgoed.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/team.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renovatie",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renovatie.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renovatie-nijmegen",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renovatie-nijmegen.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renovatie-arnhem",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/renovatie-arnhem.html",
      "destination": "/",
      "permanent": true
